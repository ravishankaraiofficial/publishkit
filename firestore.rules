rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Whitelist and config — Cloud Functions only, no client access
    match /config/{document} {
      allow read, write: if false;
    }

    // IP usage counters — Cloud Functions only (Admin SDK bypasses rules)
    match /ipUsage/{document=**} {
      allow read, write: if false;
    }

    // Users: read entire subtree, write only the top-level profile doc
    // Usage subcollection is written only by Admin SDK (Cloud Functions)
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['plan', 'planExpiry', 'razorpaySubscriptionId']);
    }

    // Usage readable for UI display (write locked, Admin SDK only)
    match /users/{uid}/usage/{month} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Ultra trials for Script Writer and Repurposing Planner
    match /users/{uid}/ultraTrials/{feature} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feedback board — anyone can read, only real signed-in users can create/vote
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // Replies to feedback — anyone can read, only real signed-in users can create
      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
